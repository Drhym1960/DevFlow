# App
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string

# Database (SQLite by default)
DATABASE_URL="file:./dev.db"

# Optional LLM (OpenAI-compatible). Leave empty to use the Studio Copy Engine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional image generation
OPENAI_IMAGE_MODEL=dall-e-3

# Optional TTS
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional Stripe-shaped payments adapter
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Talking motion (image + audio → performing presenter)
# Local SadTalker is the default (face + head). For full-body walk/turn/gesture:
# MOTION_PROVIDER=sora
MOTION_PROVIDER=
SORA_MODEL=sora-2
SORA_SECONDS=12
D_ID_API_KEY=
FAL_KEY=
SADTALKER_DIR=./vendor/SadTalker
TALK_FRAME_DIR=

# Storage
STORAGE_DRIVER=local
STORAGE_DIR=./data
